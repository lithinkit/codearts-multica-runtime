    "check": "npm run typecheck && npm run test && npm run build"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "typescript": "~5.8.0",
    "vitest": "^4.1.0"
  }
}