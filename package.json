{
  "name": "codearts-multica-runtime",
  "version": "1.0.0",
  "private": true,
  "description": "CodeArts Agent runtime bridge for Multica",
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
